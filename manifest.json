{
  "manifest_version": 3,
  "name": "Feedback Autofill",
  "version": "2.0",
  "description": "Automatically fills the student feedback form. You solve the captcha and submit.",
  "permissions": ["activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Re-fill feedback form" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
